# Backend Server Port
PORT=5000

# MongoDB Connection String
# Option 1: Local MongoDB (Community Server / Compass)
MONGO_URI=mongodb://127.0.0.1:27017/academic_tracker_db

# Option 2: MongoDB Atlas (Free Cloud Database)
# Replace <username>, <password>, and <cluster-url> with your MongoDB Atlas details:
# MONGO_URI=mongodb+srv://<username>:<password>@<cluster-url>.mongodb.net/academic_tracker_db?retryWrites=true&w=majority
